ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Server=localhost\SQLEXPRESS;Database=GestionAgenda;Trusted_Connection=True;TrustServerCertificate=True
Jwt__Secret=
Jwt__Issuer=GestionAgenda
Jwt__Audience=GestionAgenda
Cors__Origins__0=https://agenda.exemple
Notifications__Email__Host=
Notifications__Email__Port=587
Notifications__Email__Expediteur=agenda@softwell.local
Notifications__Email__Utilisateur=
Notifications__Email__MotDePasse=
Notifications__Push__Sujet=mailto:agenda@softwell.local
Notifications__Push__ClePublique=
Notifications__Push__ClePrivee=

# Ces variables se posent dans IIS, sur le pool ou le site, pas dans le dépôt.
# Jwt__Secret doit contenir au moins 32 caractères. Sans lui, l'API refuse de démarrer.
# Cors__Origins peut aussi être une chaîne séparée par des virgules : Cors__Origins=https://a,https://b
# Le front lit /assets/config.json. Renseigner apiUrl avec l'adresse publique de l'API, sinon le build de production appelle /api sur le même site.
